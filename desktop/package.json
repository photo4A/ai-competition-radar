{
  "name": "saixun-radar-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "赛讯 Radar 桌面快捷入口",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.saixun.radar",
    "productName": "赛讯 Radar",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.news"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
